<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/cardChargingSession" style="@style/TechCard.Interactive" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp">
  <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="16dp">
    <ImageView android:id="@+id/ivChargeIcon" android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/bg_badge_demo" android:padding="8dp" android:src="@drawable/ic_battery_bolt" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" app:tint="@color/tech_cyan" />
    <TextView android:id="@+id/tvChargeType" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="Sạc nhanh 67 W" android:textColor="@color/tech_text_primary" android:textSize="15sp" android:textStyle="bold" app:layout_constraintEnd_toStartOf="@+id/ivStar" app:layout_constraintStart_toEndOf="@+id/ivChargeIcon" app:layout_constraintTop_toTopOf="parent" />
    <TextView android:id="@+id/tvTimeRange" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_marginTop="2dp" android:text="Hôm nay • 08:30 - 09:12" android:textColor="@color/tech_text_secondary" android:textSize="12sp" app:layout_constraintEnd_toStartOf="@+id/ivStar" app:layout_constraintStart_toEndOf="@+id/ivChargeIcon" app:layout_constraintTop_toBottomOf="@+id/tvChargeType" />
    <ImageView android:id="@+id/ivStar" android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_star" android:visibility="gone" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" app:tint="@color/tech_yellow" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:gravity="start" android:orientation="vertical" app:layout_constraintTop_toBottomOf="@+id/ivChargeIcon">
      <!-- Percentage Change Pill -->
      <TextView android:id="@+id/tvLevelDelta" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_badge_green" android:text="15% → 85% (+70%)" android:maxLines="1" android:ellipsize="end" android:textColor="@color/tech_green" android:textSize="12sp" android:textStyle="bold" />
      <!-- Duration -->
      <TextView android:id="@+id/tvDuration" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:maxLines="2" android:ellipsize="end" android:drawableStart="@drawable/ic_usage_time" android:drawablePadding="4dp" android:drawableTint="@color/tech_text_muted" android:text="42 phút" android:textColor="@color/tech_text_secondary" android:textSize="12sp" />
      
    </LinearLayout>
  </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
