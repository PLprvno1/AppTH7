<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="match_parent" android:fitsSystemWindows="true" android:background="@color/tech_bg" tools:context=".ChargingHistoryActivity">

    <!-- Toolbar -->
    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/historyToolbar" style="@style/TechToolbar" android:layout_width="match_parent" android:layout_height="?attr/actionBarSize" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" app:menu="@menu/menu_toolbar_history" app:navigationIcon="@drawable/ic_arrow_back" app:title="@string/history_title" />

    <!-- Summary Metrics Header Card -->
    <com.google.android.material.card.MaterialCardView android:id="@+id/cardSummaryHeader" style="@style/TechCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_marginTop="8dp" android:layout_marginEnd="16dp" app:layout_constraintTop_toBottomOf="@+id/historyToolbar">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="16dp">

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tổng phiên" android:textColor="@color/tech_text_muted" android:textSize="11sp" />

                <TextView android:id="@+id/tvTotalSessions" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="0 phiên" android:textColor="@color/tech_cyan" android:textSize="18sp" android:textStyle="bold" />
            </LinearLayout>

            <View android:layout_width="1dp" android:layout_height="match_parent" android:background="@color/tech_divider" />

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Thời lượng TB" android:textColor="@color/tech_text_muted" android:textSize="11sp" />

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:id="@+id/tvAverageDuration" android:text="@string/value_unavailable" android:textColor="@color/tech_text_primary" android:textSize="18sp" android:textStyle="bold" />
            </LinearLayout>

            <View android:layout_width="1dp" android:layout_height="match_parent" android:background="@color/tech_divider" />

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tốc độ đỉnh" android:textColor="@color/tech_text_muted" android:textSize="11sp" />

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/value_unavailable" android:textColor="@color/tech_green" android:textSize="18sp" android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Filter Chips -->
    <HorizontalScrollView android:id="@+id/scrollFilters" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_marginTop="12dp" android:layout_marginEnd="16dp" android:scrollbars="none" app:layout_constraintTop_toBottomOf="@+id/cardSummaryHeader">

        <com.google.android.material.chip.ChipGroup android:id="@+id/chipGroupHistoryFilters" android:layout_width="wrap_content" android:layout_height="wrap_content" app:selectionRequired="true" app:singleLine="true" app:singleSelection="true">

            <com.google.android.material.chip.Chip android:id="@+id/chipHistAll" style="@style/TechChip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" android:text="@string/history_filter_all" />

            <com.google.android.material.chip.Chip android:id="@+id/chipHistFast" style="@style/TechChip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/history_filter_wired" />

            <com.google.android.material.chip.Chip android:id="@+id/chipHistStandard" style="@style/TechChip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/history_filter_wired" />

            <com.google.android.material.chip.Chip android:id="@+id/chipHistWireless" style="@style/TechChip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/history_filter_wireless" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <!-- Context Menu Hint Banner -->
    <TextView android:id="@+id/tvContextMenuHint" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_marginTop="6dp" android:layout_marginEnd="16dp" android:text="@string/history_context_hint" android:textColor="@color/tech_text_muted" android:textSize="11sp" app:layout_constraintTop_toBottomOf="@+id/scrollFilters" />

    <!-- RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/recyclerChargingHistory" android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="8dp" android:clipToPadding="false" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingBottom="16dp" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintTop_toBottomOf="@+id/tvContextMenuHint" />

    <!-- Empty State View -->
    <LinearLayout android:id="@+id/layoutEmptyHistory" android:layout_width="match_parent" android:layout_height="0dp" android:gravity="center" android:orientation="vertical" android:padding="32dp" android:visibility="gone" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintTop_toBottomOf="@+id/tvContextMenuHint">

        <ImageView android:layout_width="64dp" android:layout_height="64dp" android:background="@drawable/bg_badge_demo" android:padding="16dp" android:src="@drawable/ic_history" app:tint="@color/tech_cyan" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/history_empty_title" android:textColor="@color/tech_text_primary" android:textSize="16sp" android:textStyle="bold" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:gravity="center" android:text="@string/history_empty_desc" android:textColor="@color/tech_text_secondary" android:textSize="13sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
