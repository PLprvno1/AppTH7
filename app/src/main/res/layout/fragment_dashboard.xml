<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/tech_bg" android:fillViewport="true">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="16dp" android:paddingTop="8dp" android:paddingEnd="16dp" android:paddingBottom="24dp">
    <!-- Top Header Info -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
      <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/dashboard_title" android:textColor="@color/tech_text_primary" android:textSize="22sp" android:textStyle="bold" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/dashboard_subtitle" android:textColor="@color/tech_text_secondary" android:textSize="13sp" />
      </LinearLayout>
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_badge_demo" android:text="@string/battery_badge_recorded" android:textColor="@color/tech_cyan" android:textSize="10sp" android:textStyle="bold" />
    </LinearLayout>
    <!-- Main Battery Gauge Card -->
    <com.google.android.material.card.MaterialCardView android:id="@+id/cardMainBattery" style="@style/TechCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_horizontal" android:orientation="vertical" android:padding="20dp">
        <com.example.th7.widget.CircularBatteryGaugeView android:id="@+id/circularGaugeView" android:layout_width="230dp" android:layout_height="230dp" />
        <!-- Bottom Status Indicator within card -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center_vertical" android:orientation="horizontal">
          <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_battery_bolt" app:tint="@color/tech_cyan" />
          <TextView android:id="@+id/tvBatteryStatusDetail" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:layout_weight="1" android:text="Đang chờ dữ liệu pin" android:textColor="@color/tech_text_secondary" android:textSize="12sp" />
        </LinearLayout>
        <TextView android:id="@+id/tvBatteryLastUpdated" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="22dp" android:layout_marginTop="4dp" android:textColor="@color/tech_text_muted" android:textSize="11sp" />
      </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    <!-- Quick Info Grid (2 Rows of 2 Cards) -->
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:layout_marginBottom="10dp" android:text="Chỉ số vận hành tức thời" android:textColor="@color/tech_text_secondary" android:textSize="13sp" android:textStyle="bold" />
    <!-- Row 1 -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
      <!-- Android thermal health state -->
      <com.google.android.material.card.MaterialCardView style="@style/TechCard" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginEnd="6dp" android:layout_weight="1" android:minHeight="180dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
          <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <ImageView android:layout_width="28dp" android:layout_height="28dp" android:background="@drawable/bg_card_inner" android:padding="6dp" android:src="@drawable/ic_warning" app:tint="@color/tech_cyan" />
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_badge_demo" android:id="@+id/tvQuickThermalBadge" android:text="DỮ LIỆU" android:textColor="@color/tech_green" android:textSize="9sp" android:textStyle="bold" />
          </LinearLayout>
          <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="@string/thermal_state_title" android:textColor="@color/tech_text_muted" android:textSize="11sp" />
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:id="@+id/tvQuickThermalValue" android:text="@string/thermal_state_unknown" android:textColor="@color/tech_text_primary" android:textSize="18sp" android:textStyle="bold" android:maxLines="2" android:ellipsize="end" android:minLines="1" />
          <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textColor="@color/tech_green" android:textSize="11sp" android:id="@+id/tvQuickThermalStatus" android:text="N/A" />
        </LinearLayout>
      </com.google.android.material.card.MaterialCardView>
      <!-- Charging Status Card -->
      <com.google.android.material.card.MaterialCardView style="@style/TechCard" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="6dp" android:layout_weight="1" android:minHeight="180dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
          <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <ImageView android:layout_width="28dp" android:layout_height="28dp" android:background="@drawable/bg_card_inner" android:padding="6dp" android:src="@drawable/ic_charging_plug" app:tint="@color/tech_cyan" />
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_badge_demo" android:id="@+id/tvQuickChargeBadge" android:text="NGUỒN ĐIỆN" android:textColor="@color/tech_cyan" android:textSize="9sp" android:textStyle="bold" />
          </LinearLayout>
          <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="@string/quick_charging_label" android:textColor="@color/tech_text_muted" android:textSize="11sp" />
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:id="@+id/tvQuickChargingValue" android:text="@string/quick_charging_value" android:textColor="@color/tech_text_primary" android:textSize="16sp" android:textStyle="bold" android:minLines="2" />
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:id="@+id/tvQuickChargingStatus" android:text="@string/quick_charging_status" android:textColor="@color/tech_text_secondary" android:textSize="11sp" />
        </LinearLayout>
      </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
    <!-- Row 2 -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal">
      <!-- Estimated Usage Time Card -->
      <com.google.android.material.card.MaterialCardView style="@style/TechCard" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginEnd="6dp" android:layout_weight="1" android:minHeight="180dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
          <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <ImageView android:layout_width="28dp" android:layout_height="28dp" android:background="@drawable/bg_card_inner" android:padding="6dp" android:src="@drawable/ic_usage_time" app:tint="@color/tech_blue" />
          </LinearLayout>
          <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="@string/quick_usage_label" android:textColor="@color/tech_text_muted" android:textSize="11sp" />
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:id="@+id/tvQuickUsageValue" android:text="@string/quick_usage_value" android:textColor="@color/tech_text_primary" android:textSize="18sp" android:textStyle="bold" android:maxLines="2" android:ellipsize="end" android:minLines="2" />
        </LinearLayout>
      </com.google.android.material.card.MaterialCardView>
      <!-- Battery Health Card -->
      <com.google.android.material.card.MaterialCardView style="@style/TechCard" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="6dp" android:layout_weight="1" android:minHeight="180dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
          <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <ImageView android:layout_width="28dp" android:layout_height="28dp" android:background="@drawable/bg_card_inner" android:padding="6dp" android:src="@drawable/ic_battery_std" app:tint="@color/tech_text_muted" />
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
          </LinearLayout>
          <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="@string/quick_health_label" android:textColor="@color/tech_text_muted" android:textSize="11sp" />
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/battery_health_unavailable" android:textColor="@color/tech_text_primary" android:textSize="16sp" android:textStyle="bold" android:id="@+id/tvHealthStatus" android:minLines="2" />
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textColor="@color/tech_text_secondary" android:textSize="11sp" android:id="@+id/tvHealthInfo" android:text="@string/battery_health_android_disclaimer" />
        </LinearLayout>
      </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
    <!-- Mini Stats Activity Card -->
    <com.google.android.material.card.MaterialCardView style="@style/TechCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
          <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/mini_stats_title" android:textColor="@color/tech_text_primary" android:textSize="16sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/mini_stats_subtitle" android:textColor="@color/tech_text_secondary" android:textSize="12sp" />
          </LinearLayout>
          <com.google.android.material.button.MaterialButton android:id="@+id/btnNavStatistics" android:layout_width="wrap_content" android:layout_height="36dp" android:background="@drawable/bg_button_secondary" android:paddingStart="12dp" android:paddingEnd="12dp" android:text="@string/btn_view_details" android:textColor="@color/tech_cyan" android:textSize="12sp" app:backgroundTint="@null" />
        </LinearLayout>
        <!-- Mini Tech Graph -->
        <com.example.th7.widget.TechGraphView android:id="@+id/miniGraphView" android:layout_width="match_parent" android:layout_height="140dp" android:layout_marginTop="8dp" />
      </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
  </LinearLayout>
</androidx.core.widget.NestedScrollView>
