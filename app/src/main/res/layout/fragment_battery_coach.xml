<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/tech_bg" android:fillViewport="true">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="16dp" android:paddingTop="12dp" android:paddingEnd="16dp" android:paddingBottom="24dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/tips_title" android:textColor="@color/tech_text_primary" android:textSize="22sp" android:textStyle="bold" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/tips_subtitle" android:textColor="@color/tech_text_secondary" android:textSize="13sp" />
    <com.google.android.material.card.MaterialCardView style="@style/TechCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="16dp">
        <TextView android:id="@+id/tipsCompletedSummary" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="@color/tech_green" android:textSize="14sp" android:textStyle="bold" />
        <TextView android:id="@+id/tipsAttentionSummary" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="end" android:textColor="@color/tech_yellow" android:textSize="14sp" android:textStyle="bold" />
      </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    <com.google.android.material.chip.ChipGroup android:id="@+id/tipsFilterGroup" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" app:selectionRequired="true" app:singleSelection="true">
      <com.google.android.material.chip.Chip android:id="@+id/tipsFilterAll" style="@style/TechChip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" android:text="@string/filter_all" />
      <com.google.android.material.chip.Chip android:id="@+id/tipsFilterPending" style="@style/TechChip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/tips_filter_pending" />
      <com.google.android.material.chip.Chip android:id="@+id/tipsFilterDone" style="@style/TechChip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/tips_filter_done" />
    </com.google.android.material.chip.ChipGroup>
    <TextView android:id="@+id/tipsEmpty" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:padding="20dp" android:text="@string/tips_empty" android:textColor="@color/tech_text_secondary" android:visibility="gone" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/recyclerTips" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:nestedScrollingEnabled="false" />
    <com.google.android.material.card.MaterialCardView style="@style/TechCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/analysis_card_title" android:textColor="@color/tech_text_primary" android:textSize="18sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="@string/analysis_card_subtitle" android:textColor="@color/tech_text_secondary" android:textSize="13sp" />
        <TextView android:id="@+id/offlineAnalysisSummary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textColor="@color/tech_text_primary" android:textSize="14sp" android:textStyle="bold" />
        <TextView android:id="@+id/offlineAnalysisQuality" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:textColor="@color/tech_text_secondary" android:textSize="13sp" />
        <TextView android:id="@+id/offlineAnalysisAvailable" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="@color/tech_text_secondary" android:textSize="12sp" android:lineSpacingExtra="2dp" />
        <TextView android:id="@+id/offlineAnalysisFindings" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textColor="@color/tech_text_primary" android:textSize="14sp" android:lineSpacingExtra="2dp" />
        <TextView android:id="@+id/offlineAnalysisRecommendations" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:textColor="@color/tech_text_primary" android:textSize="14sp" android:lineSpacingExtra="2dp" />
        <TextView android:id="@+id/offlineAnalysisUnavailable" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:textColor="@color/tech_text_secondary" android:textSize="12sp" android:lineSpacingExtra="2dp" />
      </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    <com.google.android.material.card.MaterialCardView style="@style/TechCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/gemini_card_title" android:textColor="@color/tech_text_primary" android:textSize="18sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/gemini_card_description" android:textColor="@color/tech_text_secondary" android:textSize="13sp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/buttonGeminiAnalysis" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/gemini_analyze" app:icon="@drawable/ic_coach" />
        <ProgressBar android:id="@+id/geminiProgress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:indeterminate="true" android:visibility="gone" />
        <TextView android:id="@+id/geminiStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="@color/tech_text_secondary" android:textSize="13sp" android:visibility="gone" />
        <TextView android:id="@+id/geminiResultTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="@string/gemini_result_title" android:textColor="@color/tech_text_primary" android:textSize="15sp" android:textStyle="bold" android:visibility="gone" />
        <TextView android:id="@+id/geminiResult" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:lineSpacingExtra="3dp" android:textColor="@color/tech_text_primary" android:textSize="14sp" android:visibility="gone" />
      </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
  </LinearLayout>
</androidx.core.widget.NestedScrollView>
