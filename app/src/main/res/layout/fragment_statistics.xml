<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/tech_bg" android:fillViewport="true">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="16dp" android:paddingTop="8dp" android:paddingEnd="16dp" android:paddingBottom="24dp">
    <!-- Header -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
      <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/stats_title" android:textColor="@color/tech_text_primary" android:textSize="22sp" android:textStyle="bold" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/stats_subtitle" android:textColor="@color/tech_text_secondary" android:textSize="13sp" />
      </LinearLayout>
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_badge_demo" android:text="@string/stats_badge_saved" android:textColor="@color/tech_cyan" android:textSize="10sp" android:textStyle="bold" />
    </LinearLayout>
    <!-- Time Range Selector Chips -->
    <com.google.android.material.button.MaterialButtonToggleGroup android:id="@+id/toggleTimeRange" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" app:checkedButton="@+id/btnRange24h" app:selectionRequired="true" app:singleSelection="true">
      <com.google.android.material.button.MaterialButton android:id="@+id/btnRange24h" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:text="@string/range_24h" android:textColor="@color/tech_text_primary" android:textSize="12sp" app:strokeColor="@color/tech_card_stroke" />
      <com.google.android.material.button.MaterialButton android:id="@+id/btnRange7d" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:text="@string/range_7d" android:textColor="@color/tech_text_secondary" android:textSize="12sp" app:strokeColor="@color/tech_card_stroke" />
      <com.google.android.material.button.MaterialButton android:id="@+id/btnRange30d" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:text="@string/range_30d" android:textColor="@color/tech_text_secondary" android:textSize="12sp" app:strokeColor="@color/tech_card_stroke" />
    </com.google.android.material.button.MaterialButtonToggleGroup>
    <TextView android:id="@+id/statsRangeCoverage" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="@color/tech_text_muted" android:textSize="12sp" />
    <!-- Main Chart Card -->
    <com.google.android.material.card.MaterialCardView style="@style/TechCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
        <!-- Metric Switcher Tabs -->
        <com.google.android.material.tabs.TabLayout android:id="@+id/tabLayoutMetrics" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:background="@drawable/bg_card_inner" app:tabGravity="center" app:tabIndicatorAnimationMode="elastic" app:tabIndicatorColor="@color/tech_cyan" app:tabMode="scrollable" app:tabSelectedTextColor="@color/tech_cyan" app:tabTextAppearance="@style/TextAppearance.Material3.LabelSmall" app:tabTextColor="@color/tech_text_secondary">
          <com.google.android.material.tabs.TabItem android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/tab_level" />
          
          <com.google.android.material.tabs.TabItem android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/tab_current" />
        </com.google.android.material.tabs.TabLayout>
        <!-- Chart Title & Current Reading -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:orientation="vertical">
          <TextView android:id="@+id/tvChartTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Biến thiên dung lượng pin" android:textColor="@color/tech_text_primary" android:textSize="14sp" android:textStyle="bold" />
          <TextView android:id="@+id/tvCurrentMetricVal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/value_unavailable" android:textColor="@color/tech_cyan" android:textSize="14sp" android:textStyle="bold" />
        </LinearLayout>
        <!-- Detailed Tech Graph -->
        <com.example.th7.widget.TechGraphView android:id="@+id/mainTechGraph" android:layout_width="match_parent" android:layout_height="210dp" android:layout_marginTop="8dp" />
      </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    <!-- App Usage Log -->
    <com.google.android.material.card.MaterialCardView style="@style/TechCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/usage_log_title" android:textColor="@color/tech_text_primary" android:textSize="16sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/usage_log_description" android:textColor="@color/tech_text_secondary" android:textSize="12sp" />
        <com.google.android.material.button.MaterialButtonToggleGroup android:id="@+id/toggleUsageRange" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" app:checkedButton="@+id/usageRangeToday" app:selectionRequired="true" app:singleSelection="true">
          <com.google.android.material.button.MaterialButton android:id="@+id/usageRangeToday" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:text="@string/usage_filter_today" android:textSize="11sp" />
          <com.google.android.material.button.MaterialButton android:id="@+id/usageRange7Days" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:text="@string/usage_filter_7_days" android:textSize="11sp" />
          <com.google.android.material.button.MaterialButton android:id="@+id/usageRange30Days" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:text="@string/usage_filter_30_days" android:textSize="11sp" />
        </com.google.android.material.button.MaterialButtonToggleGroup>
        <TextView android:id="@+id/usageTotal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textColor="@color/tech_cyan" android:textSize="14sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/usage_battery_unavailable" android:textColor="@color/tech_text_muted" android:textSize="12sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/usage_privacy_note" android:textColor="@color/tech_text_muted" android:textSize="12sp" />
        <ProgressBar android:id="@+id/usageProgress" style="?android:attr/progressBarStyle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:layout_marginTop="12dp" android:visibility="gone" />
        <TextView android:id="@+id/usageStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:textColor="@color/tech_text_secondary" android:textSize="13sp" android:visibility="gone" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnUsageAccess" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:minHeight="44dp" android:text="@string/usage_access_button" android:textColor="@color/tech_cyan" android:visibility="gone" app:strokeColor="@color/tech_card_stroke" />
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/appUsageList" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:nestedScrollingEnabled="false" android:visibility="gone" />
      </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    <!-- Charging History Preview -->
    <com.google.android.material.card.MaterialCardView style="@style/TechCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
          <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/recent_sessions_title" android:textColor="@color/tech_text_primary" android:textSize="15sp" android:textStyle="bold" />
          <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_badge_demo" android:text="@string/stats_badge_recent" android:textColor="@color/tech_cyan" android:textSize="9sp" />
        </LinearLayout>
        <!-- Mini Session 1 -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/bg_card_inner" android:gravity="center_vertical" android:orientation="horizontal" android:padding="12dp">
          <ImageView android:layout_width="32dp" android:layout_height="32dp" android:background="@drawable/bg_badge_demo" android:padding="6dp" android:src="@drawable/ic_battery_bolt" app:tint="@color/tech_cyan" />
          <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/stats_recent_empty_title" android:textColor="@color/tech_text_primary" android:textSize="13sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/stats_recent_empty_desc" android:textColor="@color/tech_text_secondary" android:textSize="11sp" />
          </LinearLayout>
          <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_badge_green" android:text="@string/value_unavailable" android:textColor="@color/tech_green" android:textSize="11sp" android:textStyle="bold" />
        </LinearLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/btnViewAllHistory" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="12dp" android:background="@drawable/bg_button_secondary" android:text="@string/btn_all_history" android:textColor="@color/tech_cyan" android:textSize="13sp" app:backgroundTint="@null" />
      </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
  </LinearLayout>
</androidx.core.widget.NestedScrollView>
